# Development tools (NOT for end users - gitignored)
tools/                      # Dev scripts (screenshot gen, favicon gen, etc.)
!tools/linux-diag/            # Linux network diagnostics dispatcher (lzt-netdiag) - COMMITTED
docs/assets/screenshots/    # Auto-generated screenshots (upload to VPS instead)
playwright/                 # Browser automation cache
.playwright/

# Keep these assets (small, version-controlled)
!docs/assets/logo/          # Logos and favicons (46 KB total) - COMMITTED

# Temporary files
*.tmp
temp/
/scratch/

# ============ TAURI / RUST ============
# Rust build artifacts
platforms/tauri/src-tauri/target/
target/
# Cargo.lock se ignora por defecto (crates auxiliares del repo), EXCEPTO el de
# la app Tauri: es una aplicación binaria y sin lock el resolver de cargo flota
# al último 2.x de cada crate de la familia tauri (sus requisitos son caret
# dentro del 2.x), que es justo lo que rompe el build — tauri 2.11 con
# tauri-macros 2.7 no compila, porque el macro genera
# Error::UnexpectedMenuKind y esa variante sólo existe en tauri 2.12.
Cargo.lock
!platforms/tauri/src-tauri/Cargo.lock
*.rlib
*.rmeta
**/*.rs.bk
*.pdb

# Nuitka crash reports
nuitka-crash-report.xml

# ============ NODE.JS / SVELTEKIT ============
node_modules/
.svelte-kit/
.env
.env.*
!.env.example
# Lock files - using pnpm (pnpm-lock.yaml is committed)
package-lock.json
yarn.lock

# SvelteKit build
platforms/tauri/build/
platforms/tauri/.svelte-kit/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ============ TAURI SPECIFIC ============
# Tauri build outputs
platforms/tauri/src-tauri/WixTools/
platforms/tauri/src-tauri/*.exe
platforms/tauri/src-tauri/*.msi
platforms/tauri/src-tauri/*.dmg
platforms/tauri/src-tauri/*.AppImage
platforms/tauri/src-tauri/*.deb

# Private user backgrounds (not committed)
platforms/tauri/static/backgrounds/private/*
!platforms/tauri/static/backgrounds/private/.gitkeep

# Tauri debug symbols
*.dSYM/

# ============ WINDOWS BUILD ============
windows/build/
windows/$null
*.spec
